<div style="align-self: flex-start; max-width: 88%; padding: 12px 14px; border-radius: 4px 14px 14px 14px; background: #FFFFFF; font-size: 14px; line-height: 1.6">문의할 차량을 선택해 주세요.</div>
<div style="display: flex; flex-wrap: wrap; gap: 6px">
<div data-for="cars" style="display: contents"></div>
<button type="button" style="min-height: 36px; padding: 0 12px; border-radius: 999px; border: 1px solid #C9D1F7; background: #FFFFFF; color: #3B4FD8; font-family: inherit; font-size: 13px">다른 차량 검색</button>
</div>
</div>
<div data-if="hasCar" style="display: contents">
<div style="align-self: flex-end; padding: 10px 14px; border-radius: 14px 4px 14px 14px; background: #3B4FD8; color: #FFFFFF; font-size: 14px"><span data-text="car.plate"></span></div>
<div style="align-self: flex-start; width: 88%; padding: 14px; border-radius: 4px 14px 14px 14px; background: #FFFFFF; display: flex; flex-direction: column; gap: 8px; font-size: 13px">
<span style="font-size: 14px; line-height: 1.5">상담원에게 아래 정보가 함께 전달됩니다. 증상을 적어주세요.</span>
<dl style="margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 6px 12px; padding: 12px; border-radius: 8px; background: #F5F6F8">
<dt style="color: #5B6270">업체</dt><dd style="margin: 0">(주)예시렌트카 본사</dd>
<dt style="color: #5B6270">차량</dt><dd style="margin: 0"><span data-text="car.plate"></span> · <span data-text="car.model"></span></dd>
<dt style="color: #5B6270">마지막 GPS</dt><dd style="margin: 0"><span data-text="car.gps"></span></dd>
<dt style="color: #5B6270">문의 유형</dt><dd style="margin: 0"><span data-text="type"></span></dd>
</dl>
</div>
<button type="button" data-act="restart" style="align-self: center; min-height: 36px; padding: 0 14px; border: 0; background: transparent; color: #3B4FD8; font-family: inherit; font-size: 13px; text-decoration: underline; cursor: pointer">처음부터 다시</button>
</div>
</div>

<div style="display: flex; align-items: center; gap: 8px; padding: 12px 14px; border-top: 1px solid #EEF0F3">
<button type="button" aria-label="사진·파일 첨부" style="width: 40px; height: 40px; border: 0; background: transparent; display: flex; align-items: center; justify-content: center"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5B6270" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M21 12l-8.5 8.5a5 5 0 0 1-7-7L14 5a3.5 3.5 0 0 1 5 5l-8.5 8.5a2 2 0 0 1-3-3L15 8"></path></svg></button>
<input type="text" aria-label="메시지 입력" placeholder="증상을 적어주세요" style="flex: 1; min-width: 0; min-height: 40px; padding: 0 12px; border: 1px solid #D5D9E1; border-radius: 999px; font-family: inherit; font-size: 14px">
</div>
</section>

<a href="#main" aria-label="채팅 상담 닫기 (채널톡 버튼)" style="position: absolute; right: 32px; bottom: 32px; width: 60px; height: 60px; border-radius: 50%; background: #3B4FD8; box-shadow: 0 6px 20px rgba(31, 36, 48, 0.2); display: flex; align-items: center; justify-content: center; text-decoration: none">
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
</a>

</div>
</section>
<script>
const TPL = {"types": {"as": "t", "html": "\n<label style=\"display: flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 16px; border-radius: 10px; border: {{t.border}}; background: {{t.bg}}; font-size: 14px; font-weight: {{t.weight}}; color: #1F2430; cursor: pointer\"><input type=\"radio\" name=\"type\" {{t.checkedAttr}} data-act=\"{{t.act}}\" style=\"accent-color: #3B4FD8; width: 18px; height: 18px\">{{t.label}}</label>\n"}, "replies": {"as": "r", "html": "\n<label style=\"display: flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 18px; border-radius: 10px; border: {{r.border}}; background: {{r.bg}}; font-size: 14px; font-weight: {{r.weight}}; cursor: pointer\"><input type=\"radio\" name=\"reply\" {{r.checkedAttr}} data-act=\"{{r.act}}\" style=\"accent-color: #3B4FD8; width: 18px; height: 18px\">{{r.label}}</label>\n"}, "faqs": {"as": "q", "html": "\n<a href=\"#faq\" style=\"padding: 12px 0; font-size: 14px; color: #1F2430; text-decoration: none; border-top: 1px solid #EEF0F3\">{{q.text}}</a>\n"}, "ctTypes": {"as": "t", "html": "\n<button type=\"button\" data-act=\"{{t.act}}\" style=\"min-height: 36px; padding: 0 12px; border-radius: 999px; border: {{t.border}}; background: {{t.bg}}; color: {{t.color}}; font-family: inherit; font-size: 13px; font-weight: {{t.weight}}; cursor: pointer\">{{t.label}}</button>\n"}, "cars": {"as": "c", "html": "\n<button type=\"button\" data-act=\"{{c.act}}\" style=\"min-height: 36px; padding: 0 12px; border-radius: 999px; border: {{c.border}}; background: {{c.bg}}; color: {{c.color}}; font-family: inherit; font-size: 13px; font-weight: {{c.weight}}; cursor: pointer\">{{c.plate}}</button>\n"}};
const state = { inquiry: { type: '데이터 미수신·위치 오류', reply: '문자' }, channeltalk: { type: '데이터 미수신·위치 오류', car: '12가3456' } };
const TYPES = ['데이터 미수신·위치 오류', '설치·탈거', '해지·계약', '청구·정산', '시동잠금', 'FMS 사용 방법', '기타'];
const FAQ = {
  '데이터 미수신·위치 오류': ['차량 위치가 갱신되지 않아요', '차량이 주차 위치에 없어요', '차량 진단으로 통신 상태 확인하기'],
  '설치·탈거': ['차량을 매각했는데 단말기는 어떻게 하나요?', '단말기를 탈거하면 서비스도 해지되나요?'],
  '해지·계약': ['단말기를 탈거하면 서비스도 해지되나요?', '해지 후에도 요금이 청구됐어요', '계약 기간과 갱신 일정은 어디서 확인하나요?'],
  '청구·정산': ['세금계산서는 어디서 받나요?', '해지 후에도 요금이 청구됐어요'],
  '시동잠금': ['시동잠금은 어떻게 해제하나요?'],
  'FMS 사용 방법': ['운행 일지는 어떻게 내려받나요?', '차량 진단으로 통신 상태 확인하기'],
  '기타': ['고객센터 이용 안내']
};
const CARS = [{ plate: '12가3456', model: '현대 아반떼', gps: '2026/10/22 12:40' }, { plate: '34나5678', model: '현대 아반떼', gps: '2026/10/22 12:23' }];
function vals(sid) {
  if (sid === 'inquiry') {
    const st = state.inquiry;
    const pick = (on) => ({ on, checkedAttr: on ? 'checked' : '', border: on ? '2px solid #3B4FD8' : '1px solid #D5D9E1', bg: on ? '#EEF1FD' : '#FFFFFF', weight: on ? '700' : '400' });
    return {
      types: TYPES.map((label) => ({ label, ...pick(label === st.type), pick: () => { st.type = label; } })),
      replies: ['전화', '문자', '문의내역에서 확인'].map((label) => ({ label, ...pick(label === st.reply), pick: () => { st.reply = label; } })),
      faqs: FAQ[st.type].map((text) => ({ text })),
      typeLabel: st.type, showDiag: st.type === '데이터 미수신·위치 오류'
    };
  }
  if (sid === 'channeltalk') {
    const st = state.channeltalk;
    const on = { border: '1.5px solid #3B4FD8', bg: '#3B4FD8', color: '#FFFFFF', weight: '500' };
    const off = { border: '1px solid #C9D1F7', bg: '#FFFFFF', color: '#3B4FD8', weight: '400' };
    const car = CARS.find((c) => c.plate === st.car) || null;
    return {
      ctTypes: TYPES.map((label) => ({ label, ...(label === st.type ? on : off), pick: () => { st.type = label; st.car = null; } })),
      cars: CARS.map((c) => ({ ...c, ...(c.plate === st.car ? on : off), pick: () => { st.car = c.plate; } })),
      type: st.type || '', hasType: !!st.type, car: car || {}, hasCar: !!st.type && !!car,
      restart: () => { st.type = null; st.car = null; }
    };
  }
  return {};
}
const ACT = {};
function render(sec) {
  const v = vals(sec.id);
  if (v.restart) ACT.restart = v.restart;
  sec.querySelectorAll('[data-for]').forEach((el) => {
    const key = el.dataset.for, t = TPL[key];
    el.innerHTML = (v[key] || []).map((it, i) => {
      const id = sec.id + ':' + key + ':' + i; ACT[id] = it.pick; it.act = id;
      return t.html.replace(/\{\{(\w+)\.(\w+)\}\}/g, (m, a, p) => a === t.as ? (it[p] ?? '') : '');
    }).join('');
  });
  sec.querySelectorAll('[data-if]').forEach((el) => { el.style.display = v[el.dataset.if] ? 'contents' : 'none'; });
  sec.querySelectorAll('[data-text]').forEach((el) => {
    el.textContent = el.dataset.text.split('.').reduce((o, k) => (o == null ? '' : o[k]), v) ?? '';
  });
}
document.addEventListener('click', (e) => {
  const a = e.target.closest('a[href="#"]');
  if (a) { e.preventDefault(); return; }
  const b = e.target.closest('button[type="submit"]'); if (b) e.preventDefault();
  const act = e.target.closest('[data-act]');
  if (act && ACT[act.dataset.act]) { ACT[act.dataset.act](); render(act.closest('.screen')); }
});
function show() {
  const id = (location.hash || '#main').slice(1);
  const sec = document.getElementById(id) || document.getElementById('main');
  document.querySelectorAll('.screen').forEach((s) => s.classList.toggle('on', s === sec));
  document.querySelectorAll('[data-tab]').forEach((t) => t.classList.toggle('on', t.dataset.tab === sec.id));
  render(sec); window.scrollTo(0, 0);
}
document.addEventListener('submit', (e) => e.preventDefault());
window.addEventListener('hashchange', show); show();
</script>
</body>
</html>
